# ================================================================
# FYCHEO DEMO — Variables de entorno
# ================================================================
# Copia este archivo como .env y rellénalo.
#
# La demo ya NO usa un proyecto Supabase propio: apunta al proyecto
# de PRODUCCIÓN de Fycheo, donde la empresa ficticia "Distribuciones
# Martínez S.A." vive como una empresa más, marcada con
# companies.is_demo = true, aislada por RLS y reiniciada cada noche.
# ================================================================

# Supabase — proyecto de PRODUCCIÓN de Fycheo.
# La clave anon es pública por diseño (viaja en el navegador); lo que
# protege los datos son las políticas RLS, no esta clave.
# Pídelas al equipo de Fycheo: hola@fycheo.es
VITE_SUPABASE_URL=https://XXXXXXXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=

# Empresa demo "Distribuciones Martínez S.A." — id fijo en producción.
VITE_DEMO_COMPANY_ID=dd5bedbe-81f6-466e-921d-06716a0de73d

# Cuenta del administrador demo (Carlos Martínez). El Panel Manager y
# el Kiosko inician sesión con ella automáticamente.
# La contraseña la fija el equipo de Fycheo al ejecutar la semilla
# (select public.demo_seed('<contraseña>')). Si falta, la demo muestra
# un error en vez de intentar el login.
VITE_DEMO_ADMIN_EMAIL=demo.admin@fycheo-demo.com
VITE_DEMO_ADMIN_PASSWORD=
